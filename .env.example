# Copie para .env e preencha. O .env real nunca é versionado (.gitignore).
#
# Este arquivo é a lista canônica das variáveis que a aplicação aceita. Elas são
# validadas por src/configs/settings.py no startup: uma obrigatória ausente ou
# com tipo inválido impede a aplicação de subir, com erro nomeando o campo.

# --- Ambiente -----------------------------------------------------------
# local | test | production. Ausente significa "local", nunca "production".
# Em production, CORS_ORIGINS não pode conter "*" nem localhost.
ENVIRONMENT=local

# --- Obrigatórias (sem default) -----------------------------------------
DATABASE_URL=postgresql+asyncpg://usuario:senha@host/database?ssl=require
JWT_SECRET=uma-chave-secreta-aleatoria

# --- Opcionais (o valor mostrado é o default) ---------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

UPLOAD_DIR=uploads/receipts
AVATAR_DIR=uploads/avatars
PAYMENT_DIR=uploads/payment_receipts

# Origens aceitas pelo CORS, separadas por vírgula (não é JSON).
CORS_ORIGINS=http://localhost:5173
