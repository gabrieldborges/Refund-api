# Copie para .env e preencha. O .env real nunca é versionado (.gitignore).
#
# Este arquivo é a lista canônica das variáveis que a aplicação aceita. Elas são
# validadas por src/configs/settings.py no startup: uma obrigatória ausente ou
# com tipo inválido impede a aplicação de subir, com erro nomeando o campo.

# --- Ambiente -----------------------------------------------------------
# local | test | production. Ausente significa "local", nunca "production".
# Em production, CORS_ORIGINS não pode conter "*" nem localhost.
ENVIRONMENT=local

# Nível de log. INFO é onde vive a linha de acesso por requisição.
LOG_LEVEL=INFO

# --- Obrigatórias (sem default) -----------------------------------------
DATABASE_URL=postgresql+asyncpg://usuario:senha@host/database?ssl=require
JWT_SECRET=uma-chave-secreta-aleatoria

# --- Opcionais (o valor mostrado é o default) ---------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

UPLOAD_DIR=uploads/receipts
AVATAR_DIR=uploads/avatars
PAYMENT_DIR=uploads/payment_receipts

# Origens aceitas pelo CORS, separadas por vírgula (não é JSON).
#
# São DUAS portas de desenvolvimento, e a segunda é fácil de esquecer:
#   5173 -> npm run dev
#   4173 -> npm run preview, que serve o BUILD DE PRODUÇÃO
#
# O preview é como se confere o build antes de implantar, então faz parte do
# fluxo normal. Sem ele aqui, o navegador recebe "400 Disallowed CORS origin"
# na pergunta prévia do POST — e o sintoma engana, porque parece que o login
# foi rejeitado quando na verdade ele nunca chegou a ser tentado.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Armazenamento de arquivos (Item 22) -------------------------------
# local | s3. "local" grava no disco da instância — ótimo em desenvolvimento
# e FATAL num PaaS de filesystem efêmero: todo comprovante evapora a cada
# redeploy, em silêncio.
STORAGE_BACKEND=local

# Quanto tempo uma URL assinada de arquivo vale, em segundos. Curto de
# propósito: a URL congela a decisão de autorização no momento em que é
# gerada, ao contrário da rota autenticada que ela substituiu.
FILE_URL_TTL_SECONDS=300

# Origem pública desta API, usada para montar as URLs assinadas do backend
# "local". Com S3 a URL vem do provedor e isto é ignorado.
PUBLIC_BASE_URL=http://localhost:3333

# Obrigatórias apenas quando STORAGE_BACKEND=s3 (a aplicação recusa subir
# sem elas). S3_ENDPOINT_URL vazio significa AWS de verdade; aponte para o
# MinIO do docker-compose ou para R2/B2/Spaces para qualquer outro.
# S3_BUCKET=refund-uploads
# S3_ENDPOINT_URL=http://localhost:9100
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
